---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Side projects, open-source software, and developer tools built by Michael Doyle."
>
  <header class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-3">
      Projects
    </h1>
    <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl">
      A curated collection of projects I own, maintain, or am a major contributor to across open-source and developer tooling.
    </p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {sortedProjects.map((project) => (
      <ProjectCard
        title={project.data.title}
        description={project.data.description}
        category={project.data.category}
        tags={project.data.tags}
        github={project.data.github}
        link={project.data.link}
      />
    ))}
  </div>

  <!-- Enticing GitHub Workshop Callout -->
  <div class="mt-16 p-8 rounded-3xl border border-neutral-200/90 dark:border-neutral-800/80 bg-gradient-to-b from-neutral-50/80 to-neutral-100/40 dark:from-neutral-900/60 dark:to-neutral-950/40 backdrop-blur-sm text-center relative overflow-hidden group shadow-sm">
    <!-- Subtle top glow accent -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-32 bg-blue-500/10 dark:bg-blue-400/10 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Live status pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 mb-4 select-none">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Active on GitHub • Building & Shipping</span>
    </div>

    <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2">
      Curious what else is brewing in the lab?
    </h3>
    <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto mb-6 leading-relaxed">
      Beyond the highlighted projects, there’s a steady stream of open-source experiments, contributions, and weekend prototypes.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="https://github.com/MichaelDoyle"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl font-medium text-sm text-white bg-neutral-900 dark:bg-neutral-100 dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-200 shadow-sm transition-all group/btn"
      >
        <svg class="w-4 h-4 fill-current transition-transform group-hover/btn:scale-110" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>See more on GitHub</span>
        <span class="text-xs transition-transform group-hover/btn:translate-x-0.5">↗</span>
      </a>

      <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-mono text-neutral-400 dark:text-neutral-500 bg-neutral-200/50 dark:bg-neutral-800/50 border border-neutral-300/50 dark:border-neutral-700/50 select-all">
        <span>$</span>
        <span>gh repo list MichaelDoyle</span>
      </div>
    </div>
  </div>
</BaseLayout>
