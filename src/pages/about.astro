---
import BaseLayout from '../layouts/BaseLayout.astro';

const careerHighlights = [
  {
    company: 'Google',
    role: 'Senior Software Engineer & Team Lead',
    period: '2017 – Present',
    team: 'Genkit & Firebase',
    description: "Leading the Genkit CLI + Dev UI team and contributing across the multi-language framework. Previously worked on Firebase Studio to enable Firestore-powered apps built by generative AI, and scaled core Firebase and Crashlytics platform infrastructure.",
  },
  {
    company: 'Twitter',
    role: 'Software Engineer',
    period: '2014 – 2017',
    team: 'Fabric',
    description: "Built high-throughput telemetry pipelines, centralized logging, and infrastructure automation for Twitter's mobile developer platform.",
  },
  {
    company: 'Goldman Sachs',
    role: 'Vice President — Senior Analyst / Developer',
    period: '2007 – 2014',
    team: 'Technology Infrastructure',
    description: "Engineered firmwide developer tools, datacenter inventory data models, and federated RESTful APIs across core enterprise technology infrastructure.",
  },
];
---

<BaseLayout
  title="About"
  description="About Michael Doyle — Senior Software Engineer and Team Lead at Google."
>
  <article class="max-w-2xl mx-auto">
    <!-- Header -->
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-4">
        About Me
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
        I'm a husband, dad, and Senior Software Engineer and Team Lead at <strong>Google</strong>, heading up developer tooling (CLI + Dev UI) for <strong>Genkit</strong> — Google's open-source framework for building AI and agentic applications.
      </p>
    </header>

    <div class="prose dark:prose-invert prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 dark:prose-a:text-blue-400">
      <p>
        With nearly 20 years of experience building developer platforms and enterprise infrastructure, my focus has centered on developer velocity, intuitive developer experience (DX), and tooling that unlocks engineering productivity at scale.
      </p>
      <p>
        At Google, I previously worked on <strong>Firebase Studio</strong> to enable Firestore-powered apps built by generative AI, and spent years scaling <strong>Firebase</strong> and <strong>Crashlytics</strong> platform infrastructure. Before that, I was at <strong>Twitter</strong> building infrastructure for <strong>Fabric</strong>, and began my career at <strong>Goldman Sachs</strong> working in core technology infrastructure. I graduated from <strong>Rensselaer Polytechnic Institute (RPI)</strong> with a dual degree in Computer Science and Information Technology.
      </p>

      <h2>Career Timeline</h2>
      <div class="not-prose my-8 space-y-4">
        {careerHighlights.map((item) => (
          <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/40">
            <div class="flex items-baseline justify-between gap-2 mb-1">
              <div class="font-semibold text-neutral-900 dark:text-neutral-100">
                {item.company}
                {item.team && <span class="text-xs font-normal text-neutral-400 dark:text-neutral-500 ml-1.5">• {item.team}</span>}
              </div>
              <div class="text-xs font-mono text-neutral-400 dark:text-neutral-500">{item.period}</div>
            </div>
            <div class="text-xs font-medium text-blue-600 dark:text-blue-400 mb-1.5">{item.role}</div>
            <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      <h2>Education</h2>
      <div class="not-prose my-6 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/40">
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-100 text-sm">
          Rensselaer Polytechnic Institute (RPI)
        </h4>
        <p class="text-xs text-neutral-600 dark:text-neutral-400">
          B.S. in Computer Science and Information Technology (Dual Major)
        </p>
      </div>

      <h2>Connect</h2>
      <p>
        I'm always open to talking about developer experience and where AI is taking software creation. Outside of tech, I'm a big personal finance nerd. Feel free to reach out anytime:
      </p>
      <div class="not-prose flex flex-wrap gap-3 mt-4">
        <a
          href="https://x.com/mikeydoyle"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
        >
          <span>𝕏</span>
          <span>@mikeydoyle</span>
        </a>
        <a
          href="https://linkedin.com/in/michaeljamesdoyle/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.62 1.62 0 0 0-1.63 1.63 1.62 1.62 0 0 0 1.63 1.62 1.62 1.62 0 0 0 1.62-1.62c0-.9-.73-1.63-1.62-1.63Z" />
          </svg>
          <span>LinkedIn</span>
        </a>
        <a
          href="https://github.com/MichaelDoyle"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
